# Google Tag Manager container (contains GA4 G-H2QR3QCZQH).
#
# Read at build time for production-mode builds. `next dev` does not read
# it. Note that Vercel PREVIEW builds are also production-mode and do
# load this file, so the container id alone is not the gate: see
# lib/analytics.ts, which additionally requires either
# VERCEL_ENV=production or the canonical hostname.
NEXT_PUBLIC_GTM_ID=GTM-5ZJ8MZKQ
